<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/bg_screen"
    tools:context=".promise.PromisePlaceFragment">

    <TextView
        android:id="@+id/text_title"
        style="@style/Text.StepTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/create_padding"
        android:layout_marginTop="@dimen/create_title_margin_top"
        android:text="@string/create_place_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_desc"
        style="@style/Text.Body16Main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/create_padding"
        android:layout_marginTop="@dimen/place_desc_margin_top"
        android:text="@string/create_place_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_title" />

    <!-- 검색창 + 지금 고른 장소 -->
    <LinearLayout
        android:id="@+id/box_search"
        android:layout_width="0dp"
        android:layout_height="@dimen/place_box_height"
        android:layout_marginStart="@dimen/place_margin_horizontal"
        android:layout_marginTop="@dimen/place_box_margin_top"
        android:layout_marginEnd="@dimen/place_margin_horizontal"
        android:background="@drawable/bg_big_input"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/place_box_padding_horizontal"
        android:paddingEnd="@dimen/place_box_padding_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_desc">

        <EditText
            android:id="@+id/edit_search"
            style="@style/Text.Body16Main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/create_place_search_hint"
            android:textColorHint="@color/text_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/text_place"
            style="@style/Text.Label13"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/place_box_info_margin_top"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="강남역 11번 출구 · 서울 강남구 강남대로 396" />
    </LinearLayout>

    <!-- 지도 자리 (비워 둠, 나중에 레이더 파트에서 채움). 검색 결과는 여기 위에 뜸 -->
    <FrameLayout
        android:id="@+id/map_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/place_margin_horizontal"
        android:layout_marginTop="@dimen/place_map_margin_top"
        android:layout_marginEnd="@dimen/place_margin_horizontal"
        android:layout_marginBottom="@dimen/place_map_margin_bottom"
        android:background="@drawable/bg_map_card"
        android:elevation="@dimen/place_map_elevation"
        android:outlineSpotShadowColor="@color/shadow_orange"
        app:layout_constraintBottom_toTopOf="@id/button_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/box_search">

        <!-- 레이더 파트 자리 표시 -->
        <TextView
            style="@style/Text.Body16Main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/create_place_radar_placeholder"
            android:textColor="@color/text_sub" />

        <!-- debug 빌드에서만 보임 (카카오 키 없을 때 테스트용) -->
        <TextView
            android:id="@+id/button_test_place"
            style="@style/Text.Link14"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="bottom|center_horizontal"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/create_place_test_fill"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_place" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_next"
        style="@style/Button.Step"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/create_button_margin_horizontal"
        android:layout_marginEnd="@dimen/create_button_margin_horizontal"
        android:layout_marginBottom="@dimen/create_button_margin_bottom"
        android:enabled="false"
        android:text="@string/common_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
