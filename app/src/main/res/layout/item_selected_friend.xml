<?xml version="1.0" encoding="utf-8"?>
<!-- 위쪽 선택한 친구 칩 (ⓧ 누르면 선택 취소) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/friends_chip_gap"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.goner.app.common.AvatarView
            android:id="@+id/avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:avatarSize="large" />

        <ImageView
            android:id="@+id/button_remove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:src="@drawable/ic_chip_remove" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_name"
        style="@style/Text.ChipName10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/friends_chip_name_margin_top"
        tools:text="이가희" />
</LinearLayout>
