<?xml version="1.0" encoding="utf-8"?>
<!-- 위치 공유 동의 시트 (Figma 370:303) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/consent_padding_top"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/consent_padding_bottom">

    <View
        android:layout_width="@dimen/sheet_handle_width"
        android:layout_height="@dimen/consent_handle_height"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        style="@style/Text.ConsentTitle20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/consent_gap"
        android:text="@string/consent_title" />

    <TextView
        style="@style/Text.ConsentDesc13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/consent_desc_gap"
        android:text="@string/consent_desc" />

    <!-- 안내 3줄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/consent_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/consent_icon_bg"
            android:layout_height="@dimen/consent_icon_bg"
            android:background="@drawable/bg_consent_icon"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_consent_clock" />

        <TextView
            style="@style/Text.ConsentItem15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/consent_row_gap"
            android:text="@string/consent_start" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/consent_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/consent_icon_bg"
            android:layout_height="@dimen/consent_icon_bg"
            android:background="@drawable/bg_consent_icon"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_consent_check" />

        <TextView
            style="@style/Text.ConsentItem15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/consent_row_gap"
            android:text="@string/consent_end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/consent_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/consent_icon_bg"
            android:layout_height="@dimen/consent_icon_bg"
            android:background="@drawable/bg_consent_icon"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_consent_users" />

        <TextView
            android:id="@+id/text_consent_members"
            style="@style/Text.ConsentItem15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/consent_row_gap"
            tools:text="이 약속 참여자 4명에게만 보여요" />
    </LinearLayout>

    <!-- 체크해야 버튼 켜짐 -->
    <LinearLayout
        android:id="@+id/button_consent_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/consent_gap"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/consent_check_padding_top">

        <ImageView
            android:id="@+id/image_consent_check"
            android:layout_width="@dimen/consent_check"
            android:layout_height="@dimen/consent_check"
            android:background="@drawable/bg_select_all_off"
            android:importantForAccessibility="no"
            android:padding="@dimen/consent_check_padding_top"
            android:src="@drawable/ic_check_white" />

        <TextView
            style="@style/Text.NotiSelectAll14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/consent_check_gap"
            android:text="@string/consent_check" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_consent_join"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/consent_gap"
        android:enabled="false"
        android:text="@string/consent_join" />
</LinearLayout>
