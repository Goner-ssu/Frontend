<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/bg_screen"
    tools:context=".main.HomeFragment">

    <!-- 상단: 로고 + 알림 + 추가 -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/home_header_height"
        android:layout_marginTop="@dimen/home_header_margin_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/home_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/logo_mark_width"
            android:layout_height="@dimen/logo_mark_height"
            android:importantForAccessibility="no"
            android:src="@drawable/logo_mark" />

        <TextView
            style="@style/Text.Logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/logo_mark_gap"
            android:letterSpacing="0.02"
            android:text="@string/splash_logo" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/button_bell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/home_bell_margin_end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_notification">

            <ImageView
                android:layout_width="@dimen/home_bell_width"
                android:layout_height="@dimen/home_bell_height"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bell" />

            <!-- 안 읽은 알림 있을 때만 보임 -->
            <View
                android:id="@+id/unread_dot"
                android:layout_width="@dimen/unread_dot"
                android:layout_height="@dimen/unread_dot"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_unread_dot"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <ImageView
            android:id="@+id/button_add"
            android:layout_width="@dimen/home_plus_size"
            android:layout_height="@dimen/home_plus_size"
            android:layout_marginEnd="@dimen/home_plus_margin_end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_add"
            android:src="@drawable/ic_home_plus" />
    </LinearLayout>

    <!-- 약속 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_promises"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/home_list_padding_top"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/home_list_padding_bottom"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_header"
        tools:listitem="@layout/item_promise" />

    <!-- 약속 없을 때 -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/empty_margin_top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_header"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="@dimen/empty_icon_bg_size"
            android:layout_height="@dimen/empty_icon_bg_size"
            android:background="@drawable/bg_empty_icon">

            <ImageView
                android:layout_width="@dimen/empty_icon_size"
                android:layout_height="@dimen/empty_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calendar" />
        </FrameLayout>

        <TextView
            style="@style/Text.Title20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/empty_title_margin_top"
            android:text="@string/home_empty_title" />

        <TextView
            style="@style/Text.Body14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/empty_desc_margin_top"
            android:gravity="center"
            android:text="@string/home_empty_desc"
            app:lineHeight="@dimen/text_14_line_height" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_create"
            style="@style/Button.Primary"
            android:layout_width="@dimen/empty_button_width"
            android:layout_height="@dimen/empty_button_height"
            android:layout_marginTop="@dimen/empty_button_margin_top"
            android:text="@string/home_empty_create" />

        <TextView
            android:id="@+id/button_add_friend"
            style="@style/Text.Link14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/empty_link_margin_top"
            android:background="?attr/selectableItemBackground"
            android:text="@string/home_empty_add_friend" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
