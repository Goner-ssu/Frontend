<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".promise.PromiseCreatedFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/button_share"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/time_content_padding_bottom">

            <!-- 완료 메시지 -->
            <ImageView
                android:layout_width="@dimen/created_check_bg"
                android:layout_height="@dimen/created_check_bg"
                android:layout_marginTop="@dimen/created_message_margin_top"
                android:background="@drawable/bg_created_check"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_check_large" />

            <TextView
                style="@style/Text.CreatedTitle26"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/created_title_margin_top"
                android:text="@string/created_title" />

            <TextView
                android:id="@+id/text_desc"
                style="@style/Text.CreatedDesc15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/created_desc_margin_top"
                android:gravity="center"
                tools:text="민수, 지현, 준호님에게 초대를 보냈어요\n모두 수락하면 약속이 확정돼요" />

            <!-- 약속 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/created_card_margin_top"
                android:background="@drawable/bg_created_card"
                android:elevation="@dimen/created_card_elevation"
                android:orientation="vertical"
                android:outlineSpotShadowColor="@color/shadow_orange"
                android:padding="@dimen/created_card_padding">

                <TextView
                    android:id="@+id/text_title"
                    style="@style/Text.Title20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="홍대 저녁 모임" />

                <TextView
                    android:id="@+id/text_time"
                    style="@style/Text.CreatedInfo14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/created_card_gap"
                    android:drawablePadding="@dimen/created_info_icon_gap"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_info_calendar"
                    tools:text="10월 24일 (토) 오후 7:00" />

                <TextView
                    android:id="@+id/text_place"
                    style="@style/Text.CreatedInfo14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/created_card_gap"
                    android:drawablePadding="@dimen/created_info_icon_gap"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_info_pin"
                    tools:text="강남역 11번 출구" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/created_divider"
                    android:layout_marginTop="@dimen/created_card_gap"
                    android:background="@color/orange_50" />

                <!-- 참여자는 코드에서 넣음 (item_created_member), 많으면 옆으로 스크롤 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/created_card_gap"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_members"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_share"
        style="@style/Button.Outline"
        android:layout_width="@dimen/created_share_width"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/create_button_margin_bottom"
        android:text="@string/created_share"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_home"
        style="@style/Button.Primary"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/created_button_gap"
        android:layout_marginEnd="@dimen/screen_padding"
        android:text="@string/created_home"
        app:layout_constraintBottom_toBottomOf="@id/button_share"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/button_share" />

</androidx.constraintlayout.widget.ConstraintLayout>
