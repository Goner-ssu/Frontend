<?xml version="1.0" encoding="utf-8"?>
<!-- 약속 초대 상세 (Figma 370:148) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    tools:context=".promise.InviteDetailActivity">

    <include
        android:id="@+id/top_bar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:layout_marginTop="@dimen/invite_header_margin_top" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/invite_detail_padding">

                <!-- 초대한 사람 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/invite_host_margin_top"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.goner.app.common.AvatarView
                        android:id="@+id/avatar_host"
                        android:layout_width="@dimen/invite_host_avatar"
                        android:layout_height="@dimen/invite_host_avatar" />

                    <TextView
                        android:id="@+id/text_host"
                        style="@style/Text.InviteHost15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/invite_host_gap"
                        tools:text="김한성님이 초대했어요" />
                </LinearLayout>

                <!-- 약속 정보 카드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/invite_detail_margin_top"
                    android:background="@drawable/bg_invite_detail_card"
                    android:elevation="@dimen/invite_detail_elevation"
                    android:orientation="vertical"
                    android:outlineSpotShadowColor="@color/shadow_orange"
                    android:padding="@dimen/invite_detail_padding">

                    <TextView
                        android:id="@+id/text_title"
                        style="@style/Text.InviteTitle24"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="홍대 저녁 모임" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/invite_detail_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/invite_info_icon"
                            android:layout_height="@dimen/invite_info_icon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_info_calendar" />

                        <TextView
                            android:id="@+id/text_time"
                            style="@style/Text.InviteInfo15"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/invite_info_gap"
                            tools:text="10월 24일 (토) 오후 7:00" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/invite_detail_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/invite_info_icon"
                            android:layout_height="@dimen/invite_info_icon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_info_pin" />

                        <TextView
                            android:id="@+id/text_place"
                            style="@style/Text.InviteInfo15"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/invite_info_gap"
                            tools:text="강남역 11번 출구" />
                    </LinearLayout>

                    <!-- 지도 미리보기 자리 (지도는 레이더 파트) -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/invite_map_height"
                        android:layout_marginTop="@dimen/invite_detail_gap"
                        android:background="@drawable/bg_invite_map">

                        <TextView
                            style="@style/Text.Label13"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/create_place_radar_placeholder" />
                    </FrameLayout>

                    <!-- 벌칙 (없음이면 숨김) -->
                    <LinearLayout
                        android:id="@+id/layout_penalty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/invite_detail_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/invite_info_icon"
                            android:layout_height="@dimen/invite_info_icon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_gift" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/invite_info_gap"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_penalty"
                                style="@style/Text.InviteInfo15"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="벌칙 · 커피 사기" />

                            <TextView
                                style="@style/Text.SummaryLabel12"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/invite_text_gap"
                                android:text="@string/invite_penalty_target" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/invite_divider"
                        android:layout_marginTop="@dimen/invite_detail_gap"
                        android:background="@color/orange_50" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/invite_detail_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_members"
                            style="@style/Text.InviteMembers14"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="참여자 4명" />

                        <TextView
                            android:id="@+id/text_members_status"
                            style="@style/Text.SummaryLabel12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="참여 2 · 대기 2" />
                    </LinearLayout>

                    <!-- 참여자는 코드에서 넣음 (item_created_member), 많으면 옆으로 스크롤 -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/invite_detail_gap"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layout_members"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progress_invite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- 위치 공유 안내 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/invite_notice_margin_vertical"
        android:layout_marginEnd="@dimen/screen_padding"
        android:background="@drawable/bg_invite_notice"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/invite_notice_padding_horizontal"
        android:paddingTop="@dimen/invite_notice_padding_vertical"
        android:paddingEnd="@dimen/invite_notice_padding_horizontal"
        android:paddingBottom="@dimen/invite_notice_padding_vertical">

        <ImageView
            android:layout_width="@dimen/invite_notice_icon"
            android:layout_height="@dimen/invite_notice_icon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_shield" />

        <TextView
            style="@style/Text.InviteNotice12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/invite_notice_gap"
            android:layout_weight="1"
            android:text="@string/invite_location_notice" />
    </LinearLayout>

    <!-- 거절 / 참여하기 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/invite_notice_margin_vertical"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/invite_cta_margin_bottom"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_reject"
            style="@style/Button.Outline"
            android:layout_width="@dimen/invite_reject_width"
            android:enabled="false"
            android:text="@string/invite_reject" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_join"
            style="@style/Button.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/invite_cta_gap"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/invite_join" />
    </LinearLayout>
</LinearLayout>
