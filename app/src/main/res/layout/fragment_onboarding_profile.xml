<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".OnboardingProfileFragment">
    
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding1_title"
                android:textColor="@color/text_color"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/onboarding1_subtitle"
                android:textColor="@color/text_color_2"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_avatar" />
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle_badge"
                    android:padding="8dp"
                    android:src="@drawable/ic_camera" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/onboarding1_nick"
                android:textColor="@color/text_color_1"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field">
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="@string/onboarding1_nickname"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="10"
                    android:paddingStart="16dp"
                    android:paddingEnd="56dp"
                    android:textColor="@color/text_color_1"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="16dp"
                    android:hint="@string/onboarding1_nickcount"
                    android:textColor="@color/text_color_1"
                    android:textSize="13sp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/onboarding1_friend"
                android:textColor="@color/text_color_1"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_field">
                <EditText
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/onboarding1_friendcode"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword"
                    android:maxLength="16"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/text_color_1"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/check_button"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_check_button"
                    android:layout_gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="@string/onboarding1_friendcodechk"
                    android:textSize="13sp"
                    android:textColor="@color/text_color"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:layout_gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/onboarding1_canuse"
                    android:textSize="13sp"
                    android:textColor="@color/orange6"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/onboarding1_limit"
                android:textColor="@color/text_color_1"
                android:textSize="13sp" />
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:layout_height="56dp"
        android:layout_width="match_parent"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="12dp"
        android:id="@+id/next_button"
        style="@style/Widget.Goner.Button.Primary"
        android:layout_marginHorizontal="24dp"
        android:text="@string/onboarding1_next" />
</LinearLayout>