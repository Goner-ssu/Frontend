<?xml version="1.0" encoding="utf-8"?>
<!-- 친구 탭 (Figma 253:2142 / 253:2193 친구 없음 / 376:160 요청 탭) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    tools:context=".friend.FriendActivity">

    <!-- 상단: 뒤로 / 친구(홈 탭) 또는 친구 요청(요청 탭) / + -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/friend_header_height"
        android:layout_marginTop="@dimen/friend_header_margin_top">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/noti_back_margin_start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_back"
            android:src="@drawable/ic_back_large" />

        <TextView
            android:id="@+id/text_title"
            style="@style/Text.Title28"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/friend_title" />

        <ImageButton
            android:id="@+id/button_add"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/friend_add_margin_end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_add_friend"
            android:src="@drawable/ic_home_plus" />
    </FrameLayout>

    <!-- 홈 / 받은 요청 / 보낸 요청 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/friend_tabs_margin_top"
        android:orientation="horizontal"
        android:paddingStart="@dimen/friend_tabs_padding_horizontal"
        android:paddingEnd="@dimen/friend_tabs_padding_horizontal">

        <LinearLayout
            android:id="@+id/tab_home"
            style="@style/FriendTab">

            <TextView
                style="@style/Text.FriendTab20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/friend_tab_home" />

            <View
                android:id="@+id/line_home"
                style="@style/FriendTabLine" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_received"
            style="@style/FriendTab">

            <TextView
                style="@style/Text.FriendTab20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/friend_tab_received" />

            <View
                android:id="@+id/line_received"
                style="@style/FriendTabLine"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_sent"
            style="@style/FriendTab">

            <TextView
                style="@style/Text.FriendTab20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/friend_tab_sent" />

            <View
                android:id="@+id/line_sent"
                style="@style/FriendTabLine"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 홈 탭 -->
        <LinearLayout
            android:id="@+id/layout_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <!-- 내 친구 코드 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/friend_card_margin_top"
                android:background="@drawable/bg_card_promise"
                android:elevation="@dimen/friend_card_elevation"
                android:orientation="vertical"
                android:outlineSpotShadowColor="@color/shadow_orange"
                android:paddingStart="@dimen/friend_card_padding_horizontal"
                android:paddingTop="@dimen/friend_card_padding_vertical"
                android:paddingEnd="@dimen/friend_card_padding_horizontal"
                android:paddingBottom="@dimen/friend_card_padding_vertical">

                <TextView
                    style="@style/Text.Label13"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/friend_my_code" />

                <TextView
                    android:id="@+id/text_my_code"
                    style="@style/Text.FriendCode22"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/friend_code_margin_top"
                    tools:text="han1234" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/friend_code_buttons_margin_top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/button_copy"
                        style="@style/Text.FriendCodeButton14"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/friend_code_button_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_outline"
                        android:text="@string/friend_copy"
                        android:textColor="@color/primary" />

                    <TextView
                        android:id="@+id/button_share"
                        style="@style/Text.FriendCodeButton14"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/friend_code_button_height"
                        android:layout_marginStart="@dimen/friend_code_button_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_host"
                        android:text="@string/friend_share"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <!-- 친구 있을 때 -->
            <LinearLayout
                android:id="@+id/layout_friend_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/text_friend_count"
                    style="@style/Text.FriendCount16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/friend_count_margin_top"
                    tools:text="친구 5" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_friends"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/friend_list_margin_top"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/screen_padding"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_friend" />
            </LinearLayout>

            <!-- 친구 없음 (Figma 253:2193) -->
            <LinearLayout
                android:id="@+id/layout_friend_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="@dimen/empty_icon_bg_size"
                    android:layout_height="@dimen/empty_icon_bg_size"
                    android:layout_marginTop="@dimen/friend_empty_margin_top"
                    android:background="@drawable/bg_friend_empty" />

                <TextView
                    style="@style/Text.Title20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/friend_empty_title_margin_top"
                    android:text="@string/friend_empty_title" />

                <TextView
                    style="@style/Text.DialogMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/friend_empty_desc_margin_top"
                    android:gravity="center"
                    android:text="@string/friend_empty_desc"
                    app:lineHeight="@dimen/text_14_line_height" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_invite"
                    style="@style/Button.Primary"
                    android:layout_width="@dimen/friend_invite_button_width"
                    android:layout_height="@dimen/empty_button_height"
                    android:layout_marginTop="@dimen/friend_invite_button_margin_top"
                    android:text="@string/friend_send_invite"
                    android:textSize="@dimen/text_16"
                    app:cornerRadius="@dimen/friend_invite_button_radius" />
            </LinearLayout>
        </LinearLayout>

        <!-- 받은 요청 / 보낸 요청 탭 (Figma 376:160) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layout_requests"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/request_list_padding_top"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/screen_padding">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_requests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_friend_request" />

                <TextView
                    android:id="@+id/text_request_empty"
                    style="@style/Text.DialogMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/request_empty_margin_top"
                    android:gravity="center"
                    android:visibility="gone"
                    tools:text="@string/request_empty_sent" />

                <TextView
                    android:id="@+id/text_request_notice"
                    style="@style/Text.SummaryLabel12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/request_notice_margin_top"
                    android:gravity="center"
                    android:text="@string/request_notice" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
