<?xml version="1.0" encoding="utf-8"?>
<!-- 알림 (Figma 253:2399 목록 / 377:398 편집 / 253:2689 빈 상태) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    tools:context=".notification.NotificationActivity">

    <!-- 상단: 뒤로 / 알림 / 편집 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:layout_marginTop="@dimen/noti_header_margin_top">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/noti_back_margin_start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_back"
            android:src="@drawable/ic_back_large" />

        <TextView
            style="@style/Text.NotiTitle22"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/noti_title" />

        <TextView
            android:id="@+id/button_edit"
            style="@style/Text.NotiAction16"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/noti_action_margin_end"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="@dimen/noti_action_padding_horizontal"
            android:paddingEnd="@dimen/noti_action_padding_horizontal"
            android:text="@string/noti_edit"
            android:visibility="invisible"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- 편집 모드: 전체 선택 / N개 선택됨 -->
    <LinearLayout
        android:id="@+id/layout_select_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/noti_select_bar_padding_vertical"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/noti_select_bar_padding_vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/button_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image_select_all"
                android:layout_width="@dimen/noti_select_all_size"
                android:layout_height="@dimen/noti_select_all_size"
                android:background="@drawable/bg_select_all_off"
                android:importantForAccessibility="no"
                android:padding="@dimen/noti_badge_stroke"
                android:src="@drawable/ic_check_white" />

            <TextView
                style="@style/Text.NotiSelectAll14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/noti_select_all_gap"
                android:text="@string/noti_select_all" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/text_selected_count"
            style="@style/Text.NotiCount14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="5개 선택됨" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_notifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_notification" />

        <ProgressBar
            android:id="@+id/progress_notifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <!-- 빈 상태 (Figma 253:2689) -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/noti_empty_icon_bg"
                android:layout_height="@dimen/noti_empty_icon_bg"
                android:background="@drawable/bg_empty_icon">

                <ImageView
                    android:layout_width="@dimen/noti_empty_icon"
                    android:layout_height="@dimen/noti_empty_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_noti_bell" />
            </FrameLayout>

            <TextView
                style="@style/Text.DialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/noti_empty_title_margin_top"
                android:text="@string/noti_empty_title" />

            <TextView
                style="@style/Text.DialogMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/noti_empty_desc_margin_top"
                android:gravity="center"
                android:text="@string/noti_empty_desc"
                app:lineHeight="@dimen/text_14_line_height" />
        </LinearLayout>
    </FrameLayout>

    <!-- 편집 모드: 선택한 알림 N개 삭제 -->
    <FrameLayout
        android:id="@+id/layout_delete_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="@dimen/noti_delete_bar_elevation"
        android:outlineSpotShadowColor="@color/shadow_orange"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/noti_delete_bar_padding_top"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/noti_delete_bar_padding_bottom"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            tools:text="선택한 알림 5개 삭제" />
    </FrameLayout>
</LinearLayout>
