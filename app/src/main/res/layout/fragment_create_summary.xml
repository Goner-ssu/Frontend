<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/bg_screen"
    tools:context=".promise.PromiseSummaryFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/button_create"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/time_content_padding_bottom">

            <TextView
                style="@style/Text.StepTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/summary_title_margin_start"
                android:layout_marginTop="@dimen/create_title_margin_top"
                android:text="@string/create_summary_title" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/summary_list_margin_top" />

            <include
                android:id="@+id/row_title"
                layout="@layout/item_summary_row" />

            <include
                android:id="@+id/row_time"
                layout="@layout/item_summary_row" />

            <include
                android:id="@+id/row_place"
                layout="@layout/item_summary_row" />

            <include
                android:id="@+id/row_friends"
                layout="@layout/item_summary_row" />

            <include
                android:id="@+id/row_penalty"
                layout="@layout/item_summary_row" />

            <TextView
                style="@style/Text.Caption12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/summary_notice_margin_top"
                android:gravity="center"
                android:text="@string/summary_notice" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_create"
        style="@style/Button.StepBold"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/create_button_margin_horizontal"
        android:layout_marginEnd="@dimen/create_button_margin_horizontal"
        android:layout_marginBottom="@dimen/create_button_margin_bottom"
        android:text="@string/summary_create"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
