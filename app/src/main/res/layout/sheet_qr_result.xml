<?xml version="1.0" encoding="utf-8"?>
<!-- QR 스캔 성공 시트 (Figma 376:378) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/consent_padding_top"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/consent_padding_bottom">

    <View
        android:layout_width="@dimen/sheet_handle_width"
        android:layout_height="@dimen/consent_handle_height"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        style="@style/Text.Label13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qr_sheet_gap"
        android:text="@string/qr_found" />

    <com.goner.app.common.AvatarView
        android:id="@+id/avatar"
        android:layout_width="@dimen/qr_sheet_avatar"
        android:layout_height="@dimen/qr_sheet_avatar"
        android:layout_marginTop="@dimen/qr_sheet_gap" />

    <TextView
        android:id="@+id/text_name"
        style="@style/Text.ConsentTitle20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qr_sheet_gap"
        tools:text="박효철" />

    <TextView
        android:id="@+id/text_code"
        style="@style/Text.Label13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/invite_text_gap"
        tools:text="\@hyo1234" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qr_sheet_gap"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_rescan"
            style="@style/Button.Outline"
            android:layout_width="@dimen/qr_rescan_width"
            android:text="@string/qr_rescan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_request"
            style="@style/Button.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/invite_cta_gap"
            android:layout_weight="1"
            tools:text="@string/qr_send_request" />
    </LinearLayout>
</LinearLayout>
